# CubeWorld player map on port 80 — install to /etc/systemd/system/
[Unit]
Description=CubeWorld player map
After=network-online.target cubeworld-server.service
Wants=network-online.target

[Service]
User=cubecraft
WorkingDirectory=/home/cubecraft/projects/cube-world/tools/playermap
Environment=PORT=80
ExecStart=/usr/bin/python3 server.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Always: lets the dev session redeploy by killing the process (same user);
# systemd respawns it on the freshly edited code.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
